<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="JobBatches" table="job_batches">
        <id name="id" type="string" column="id" length="255"/>
        <field name="name" type="string" column="name" length="255" nullable="false"/>
        <field name="totalJobs" type="integer" column="total_jobs" nullable="false"/>
        <field name="pendingJobs" type="integer" column="pending_jobs" nullable="false"/>
        <field name="failedJobs" type="integer" column="failed_jobs" nullable="false"/>
        <field name="failedJobIds" type="text" column="failed_job_ids" length="4294967295" nullable="false"/>
        <field name="options" type="text" column="options" length="16777215" nullable="true"/>
        <field name="cancelledAt" type="integer" column="cancelled_at" nullable="true"/>
        <field name="createdAt" type="integer" column="created_at" nullable="false"/>
        <field name="finishedAt" type="integer" column="finished_at" nullable="true"/>
